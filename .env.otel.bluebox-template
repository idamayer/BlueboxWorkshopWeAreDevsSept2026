# Copy this file to a local, untracked .env.otel file and fill in the values from Bluebox.
# The ingest token is not committed to the repo. Keep the full Authorization header value
# exactly as it appears in Bluebox Setup, including the scheme.

OTEL_EXPORTER_OTLP_ENDPOINT="https://<your-bluebox-otlp-endpoint>"
OTEL_EXPORTER_OTLP_HEADERS="Authorization=<scheme> <token>"
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_SERVICE_NAME=shop-api
OTEL_RESOURCE_ATTRIBUTES="deployment.environment.name=docker-compose"
